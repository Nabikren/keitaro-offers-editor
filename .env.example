# Keitaro Admin API. URL без /admin_api/v1. Ключ — только здесь, в backend env.
KEITARO_URL=
KEITARO_API_KEY=
KEITARO_TIMEOUT_SECONDS=15

# Локальная база (SQLite)
DATABASE_URL=sqlite:///./data/app.sqlite3

# Обязателен и должен начинаться с test_simonov_: Push и создание разрешены только кампаниям с этим префиксом.
# Пустой/некорректный префикс запрещает и Push, и создание. Для live-smoke — уникальный, напр. test_simonov_smoke_<random>_
CAMPAIGN_NAME_PREFIX=test_simonov_
REDIRECT_URL=https://www.google.com/

# Необязательные значения по умолчанию для формы создания (ID из GET /domains, /groups, /traffic_sources)
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=

# Разрешить запросы фронтенда dev-сервера
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PUSH_STALE_SECONDS — только предупреждение «Push, возможно, завис» (перехвата записи нет; восстановление —
# офлайн `python -m app.recover` при остановленном backend). JOB_LEASE_SECONDS — аренда задания создания кампании.
PUSH_STALE_SECONDS=120
JOB_LEASE_SECONDS=120
